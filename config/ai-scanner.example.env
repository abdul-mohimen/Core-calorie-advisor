# Create a free API key at https://openrouter.ai/keys, then add this line to
# the root .env file. Do not commit the real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: leave this as openrouter/free to automatically use a currently
# available free model with image understanding support.
OPENROUTER_MODEL=openrouter/free
